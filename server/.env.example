# ==============================================================================
# NexStay Smart Hotel System - Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://nexstay.yourdomain.com

# Database Connection (PostgreSQL for Production, SQLite for local testing)
# SQLite Local Example: "file:./dev.db"
# PostgreSQL Production Example: "postgresql://username:password@db.render.com:5432/nexstay_db?sslmode=require"
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret (Use a 256-bit high-entropy secret string)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Google Gemini API Key (Required for AI Vision OCR & Virtual Concierge)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# VNPay Payment Gateway Sandbox / Production Credentials
# Official Sandbox Portal: https://sandbox.vnpayment.vn
VNP_TMN_CODE=2QXUI4J4
VNP_HASH_SECRET=RAOANNFADDQXRIWAAXGQUXSXFCUQNODZ
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=https://nexstay-api.yourdomain.com/api/payment/vnpay_return
