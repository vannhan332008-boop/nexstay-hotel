# ==============================================================================
# NexStay Smart Hotel System - Frontend Environment Configuration (.env.example)
# Note: In Vite, all client-exposed variables MUST be prefixed with VITE_
# ==============================================================================

# Backend REST API Base URL (leave empty in local dev to leverage Vite proxy, set on Vercel)
VITE_API_URL=https://nexstay-hotel-nuxh.onrender.com

# Optional Real-Time WebSocket / Socket.io Host (defaults to VITE_API_URL)
VITE_SOCKET_URL=https://nexstay-hotel-nuxh.onrender.com

# Application Branding
VITE_HOTEL_NAME="NexStay Luxury Smart Hotel"
VITE_APP_ENV=production
